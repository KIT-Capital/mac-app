{
  "name": "mechanical-art-capital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "doppler run -- node tools/harness/start-mac-app.mjs dev --port 43173",
    "dev:plain": "node tools/harness/start-mac-app.mjs dev --port 43173",
    "db:ping": "doppler run -- node tools/harness/neon-ping.mjs",
    "db:guard": "doppler run -- node tools/harness/neon-env-guard.mjs",
    "test:unit": "node --test lib/env/database-mapping.test.mjs tools/harness/neon-env-guard.test.mjs",
    "build": "next build",
    "start": "node tools/harness/start-mac-app.mjs start --hostname 0.0.0.0 --port ${PORT:-3000}",
