# Public site (Cloudflare). Mail stays on @mechartcap.com.
NEXT_PUBLIC_SITE_URL=https://mechart.app

# Neon Postgres. Local values come from Doppler (`doppler run`), not this file.
# Never commit connection strings. APP_ENV selects the mapping; NODE_ENV does not.
APP_ENV=development
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# Optional. Signs the admin desk session cookie. Local default is fine.
DESK_SESSION_SECRET=

# Cloudflare R2 (S3 API). Local values come from Doppler. Never commit keys.
# Private originals bucket is `mac-app`. Never commit keys.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_S3_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Resend — https://resend.com/api-keys
# Without a key the app still works: mail is written to the admin outbox in preview mode.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Mechanical Art Capital <onboarding@resend.dev>
RESEND_REPLY_TO=financing@mechartcap.com

# Sentry. DSNs identify the project; the auth token is build-only for source maps.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
